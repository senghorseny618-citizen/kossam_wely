<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.RegisterController"
            style="-fx-background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">

    <center>
        <ScrollPane fitToWidth="true" 
                    style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED">
            
            <VBox alignment="CENTER" style="-fx-background-color: transparent; -fx-padding: 35 20;">
                
                <!-- Carte principale - TAILLE INTERMEDIAIRE -->
                <VBox alignment="CENTER" spacing="20"
                      style="-fx-background-color: white; -fx-background-radius: 35; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.28), 35, 0, 0, 18);"
                      maxWidth="500" prefWidth="500">
                    
                    <padding>
                        <Insets top="35" right="35" bottom="35" left="35"/>
                    </padding>

                    <!-- En-tete -->
                    <VBox alignment="CENTER" spacing="10">
                        <StackPane>
                            <Circle radius="42" fill="#2c5f2d" stroke="#7bad50" strokeWidth="2">
                                <effect>
                                    <DropShadow radius="12" color="#667eea" offsetX="0" offsetY="4"/>
                                </effect>
                            </Circle>
                            <Text text="🥛" style="-fx-font-size: 38; -fx-fill: white;"/>
                        </StackPane>
                        
                        <Text text="KOSSAM WELLI" 
                              style="-fx-font-size: 24; -fx-font-weight: 800; -fx-fill: #2d3748;"/>
                        
                        <Text text="Creer un compte" 
                              style="-fx-font-size: 14; -fx-fill: #718096;"/>
                        
                        <Rectangle width="50" height="3" arcWidth="3" arcHeight="3" fill="#2c5f2d"/>
                    </VBox>

                    <!-- Formulaire -->
                    <VBox spacing="14">
                        
                        <!-- Ligne 1: Nom -->
                        <VBox spacing="5">
                            <Text text="NOM COMPLET" style="-fx-font-size: 11; -fx-font-weight: 700; -fx-fill: #4a5568;"/>
                            <TextField fx:id="nomField" promptText="Jean Dupont"
                                       style="-fx-background-color: #f7fafc; -fx-background-radius: 14; -fx-border-color: #2c5f2d; -fx-border-radius: 14; -fx-border-width: 1.5; -fx-padding: 12 16; -fx-font-size: 13;"/>
                        </VBox>
                        
                        <!-- Ligne 2: Email -->
                        <VBox spacing="5">
                            <Text text="EMAIL" style="-fx-font-size: 11; -fx-font-weight: 700; -fx-fill: #4a5568;"/>
                            <TextField fx:id="emailField" promptText="jean@exemple.com"
                                       style="-fx-background-color: #f7fafc; -fx-background-radius: 14; -fx-border-color: #2c5f2d; -fx-border-radius: 14; -fx-border-width: 1.5; -fx-padding: 12 16; -fx-font-size: 13;"/>
                        </VBox>
                        
                        <!-- Ligne 3: Mot de passe et Confirmation sur 2 colonnes -->
                        <HBox spacing="12">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Text text="MOT DE PASSE" style="-fx-font-size: 11; -fx-font-weight: 700; -fx-fill: #4a5568;"/>
                                <PasswordField fx:id="passwordField" promptText="••••••••"
                                               style="-fx-background-color: #f7fafc; -fx-background-radius: 14; -fx-border-color: #2c5f2d; -fx-border-radius: 14; -fx-border-width: 1.5; -fx-padding: 12 16; -fx-font-size: 13;"/>
                                <Text text="Minimum 6 caracteres" style="-fx-font-size: 9; -fx-fill: #a0aec0;"/>
                            </VBox>
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Text text="CONFIRMER" style="-fx-font-size: 11; -fx-font-weight: 700; -fx-fill: #4a5568;"/>
                                <PasswordField fx:id="confirmPasswordField" promptText="••••••••"
                                               style="-fx-background-color: #f7fafc; -fx-background-radius: 14; -fx-border-color: #2c5f2d; -fx-border-radius: 14; -fx-border-width: 1.5; -fx-padding: 12 16; -fx-font-size: 13;"/>
                            </VBox>
                        </HBox>
                        
                        <!-- Ligne 4: Telephone -->
                        <VBox spacing="5">
                            <Text text="TELEPHONE" style="-fx-font-size: 11; -fx-font-weight: 700; -fx-fill: #4a5568;"/>
                            <TextField fx:id="telephoneField" promptText="77 123 45 67"
                                       style="-fx-background-color: #f7fafc; -fx-background-radius: 14; -fx-border-color: #2c5f2d; -fx-border-radius: 14; -fx-border-width: 1.5; -fx-padding: 12 16; -fx-font-size: 13;"/>
                        </VBox>
                        
                        <!-- Ligne 5: Adresse -->
                        <VBox spacing="5">
                            <Text text="ADRESSE" style="-fx-font-size: 11; -fx-font-weight: 700; -fx-fill: #4a5568;"/>
                            <TextArea fx:id="adresseField" promptText="Votre adresse complete"
                                      prefRowCount="2" wrapText="true"
                                      style="-fx-background-color: #f7fafc; -fx-background-radius: 14; -fx-border-color: #2c5f2d; -fx-border-radius: 14; -fx-border-width: 1.5; -fx-padding: 12 16; -fx-font-size: 13;"/>
                        </VBox>
                        
                        <!-- Ligne 6: Type de compte -->
                        <VBox spacing="8">
                            <Text text="TYPE DE COMPTE" style="-fx-font-size: 11; -fx-font-weight: 700; -fx-fill: #4a5568;"/>
                            <HBox spacing="15">
                                <VBox alignment="CENTER" spacing="6"
                                      style="-fx-background-color: #f0fff4; -fx-background-radius: 12; -fx-border-color: #2c5f2d; -fx-border-radius: 12; -fx-border-width: 1.5; -fx-padding: 10;"
                                      HBox.hgrow="ALWAYS">
                                    <RadioButton fx:id="clientRadio" text="Client" selected="true">
                                        <toggleGroup><ToggleGroup fx:id="roleGroup"/></toggleGroup>
                                        <style>-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #2c5f2d;</style>
                                    </RadioButton>
                                    <Text text="Achetez des produits" style="-fx-font-size: 9; -fx-fill: #718096;"/>
                                </VBox>
                                <VBox alignment="CENTER" spacing="6"
                                      style="-fx-background-color: #fef3c7; -fx-background-radius: 12; -fx-border-color: #d97706; -fx-border-radius: 12; -fx-border-width: 1.5; -fx-padding: 10;"
                                      HBox.hgrow="ALWAYS">
                                    <RadioButton fx:id="producteurRadio" text="Producteur" toggleGroup="$roleGroup">
                                        <style>-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #d97706;</style>
                                    </RadioButton>
                                    <Text text="Vendez vos produits" style="-fx-font-size: 9; -fx-fill: #718096;"/>
                                </VBox>
                            </HBox>
                        </VBox>
                        
                        <!-- Documents justificatifs -->
                        <VBox fx:id="documentsContainer" visible="false" managed="false" spacing="10" maxWidth="Infinity"
                              style="-fx-background-color: #f7fafc; -fx-background-radius: 16; -fx-padding: 15; -fx-border-color: #e2e8f0; -fx-border-radius: 16; -fx-border-width: 1.5;">
                            
                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <Text text="📎" style="-fx-font-size: 14;"/>
                                <Text text="DOCUMENTS JUSTIFICATIFS" style="-fx-font-size: 11; -fx-font-weight: 700; -fx-fill: #4a5568;"/>
                            </HBox>
                            
                            <HBox spacing="10">
                                <Button fx:id="btnAjouter" text="+ Ajouter des fichiers" onAction="#ajouterDocument" 
                                        style="-fx-background-color: #2c5f2d; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 18; -fx-background-radius: 22; -fx-font-size: 11;"/>
                                
                                <Button fx:id="btnSupprimer" text="- Supprimer" onAction="#supprimerDocument" 
                                        style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 18; -fx-background-radius: 22; -fx-font-size: 11;"/>
                                
                                <Button fx:id="btnVider" text="Vider tout" onAction="#viderListe" 
                                        style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 18; -fx-background-radius: 22; -fx-font-size: 11;"/>
                            </HBox>
                            
                            <ListView fx:id="documentsListView" prefHeight="100" 
                                      style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10;"/>
                            
                            <Label fx:id="documentsStatusLabel" text="Aucun fichier selectionne" 
                                   style="-fx-font-size: 10; -fx-text-fill: #dc3545;"/>
                            
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <Text text="PDF, JPG, PNG" style="-fx-font-size: 9; -fx-fill: #718096;"/>
                                <Text text="Max 5 Mo" style="-fx-font-size: 9; -fx-fill: #718096;"/>
                            </HBox>
                        </VBox>
                        
                        <!-- Message d'erreur -->
                        <Label fx:id="errorLabel" text="" wrapText="true"
                               style="-fx-text-fill: #dc3545; -fx-font-size: 11; -fx-background-color: #fee2e2; -fx-background-radius: 10; -fx-padding: 8;"
                               visible="false" managed="false"/>
                        
                        <Separator style="-fx-background-color: #e2e8f0;"/>

                        <!-- Bouton principal -->
                        <Button fx:id="registerButton" text="CREER MON COMPTE" onAction="#handleRegister"
                                style="-fx-background-color: #2c5f2d; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14; -fx-padding: 14; -fx-background-radius: 32;"
                                maxWidth="Infinity">
                            <effect>
                                <DropShadow radius="12" color="#2c5f2d" offsetX="0" offsetY="4"/>
                            </effect>
                        </Button>
                        
                        <!-- Lien retour -->
                        <HBox alignment="CENTER" spacing="6">
                            <Text text="Deja inscrit ?" style="-fx-font-size: 12; -fx-fill: #718096;"/>
                            <Text text="Connectez-vous" 
                                  style="-fx-font-size: 12; -fx-fill: #2c5f2d; -fx-font-weight: bold; -fx-underline: true; -fx-cursor: hand;"
                                  onMouseClicked="#goBackToLogin"/>
                        </HBox>

                    </VBox>

                    <!-- Badges de confiance -->
                    <HBox alignment="CENTER" spacing="20" style="-fx-padding: 10 0 0 0;">
                        <VBox alignment="CENTER" spacing="3">
                            <Text text="🔒" style="-fx-font-size: 14;"/>
                            <Text text="Securise" style="-fx-font-size: 9; -fx-fill: #a0aec0;"/>
                        </VBox>
                        <Rectangle width="1" height="15" fill="#e2e8f0"/>
                        <VBox alignment="CENTER" spacing="3">
                            <Text text="🚚" style="-fx-font-size: 14;"/>
                            <Text text="Livraison" style="-fx-font-size: 9; -fx-fill: #a0aec0;"/>
                        </VBox>
                        <Rectangle width="1" height="15" fill="#e2e8f0"/>
                        <VBox alignment="CENTER" spacing="3">
                            <Text text="🥛" style="-fx-font-size: 14;"/>
                            <Text text="Frais" style="-fx-font-size: 9; -fx-fill: #a0aec0;"/>
                        </VBox>
                        <Rectangle width="1" height="15" fill="#e2e8f0"/>
                        <VBox alignment="CENTER" spacing="3">
                            <Text text="⭐" style="-fx-font-size: 14;"/>
                            <Text text="Qualite" style="-fx-font-size: 9; -fx-fill: #a0aec0;"/>
                        </VBox>
                    </HBox>
                    
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>